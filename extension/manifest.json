{
  "manifest_version": 3,
  "name": "xrnrule",
  "version": "2.3.3",
  "description": "Blocks the sites xrnrule blocks on this device, shows what's left on limited ones, and tells xrnrule which site you're on.",
  "permissions": ["storage", "alarms", "declarativeNetRequest", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "scripts": ["shared.js", "background.js"] },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["block.html"], "matches": ["<all_urls>"] }
  ],
  "action": {
    "default_title": "xrnrule",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "browser_specific_settings": {
    "gecko": { "id": "xrnrule@sonn.dev", "strict_min_version": "140.0", "data_collection_permissions": { "required": ["none"] } },
    "gecko_android": { "strict_min_version": "142.0" }
  }
}
