<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Updates from the home server (update/ApkUpdater.kt): installing them, and from Android 12
         on without a confirmation each time. The Play build gets its updates from the store. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Habit reminders on the minute without asking (Android 13+); Play allows this to alarm and
         calendar apps only, so the Play build asks for SCHEDULE_EXACT_ALARM instead. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application>
        <!-- Only the installer, through our own PendingIntent, reports here. -->
        <receiver
            android:name=".update.UpdateResultReceiver"
            android:exported="false" />
    </application>
</manifest>
